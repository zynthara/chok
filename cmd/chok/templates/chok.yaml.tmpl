# {{.Name}} — chok configuration.
#
# Every key is checked: a misspelled one fails startup with a suggestion.
# Every key can also be set from the environment, named after its path:
# {{.EnvPrefix}}_HTTP_ADDR, {{.EnvPrefix}}_DB_DRIVER, {{.EnvPrefix}}_DB_SQLITE_PATH, ...
# `go run . --check-config` prints the configuration in effect.
log:
  level: info        # debug | info | warn | error; SIGHUP re-reads it
  format: json       # json | text

http:
  addr: ":8080"
  # Behind a reverse proxy (nginx, a load balancer, a CDN), list its
  # addresses or CIDRs here: otherwise X-Forwarded-For is ignored, every
  # client has the proxy's address, and rate limits count them as one.
  # trusted_proxies: ["127.0.0.1", "10.0.0.0/8"]
  openapi:
    title: {{.Name}} API

db:
  driver: sqlite     # sqlite | mysql | postgres
  migrate: auto      # auto | versioned | off — see migrations/README.md
  sqlite:
    path: {{.Name}}.db
